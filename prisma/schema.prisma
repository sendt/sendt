generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum AuctionStatus {
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

enum BidStatus {
  ACTIVE
  WON
  LOST
  REFUNDED
}

enum TransactionType {
  DEPOSIT
  BID_HOLD
  BID_REFUND
  PURCHASE
  WITHDRAWAL
  COMMISSION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  displayName   String
  password      String
  role          Role      @default(BUYER)
  avatar        String?
  bio           String?
  phone         String?
  isVerified    Boolean   @default(false)
  isBanned      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  wallet        Wallet?
  products      Product[]
  streams       LiveStream[]
  bids          Bid[]
  transactions  Transaction[]
  sentMessages  ChatMessage[]
  wonAuctions   Auction[]     @relation("AuctionWinner")
}

model Wallet {
  id         String   @id @default(cuid())
  userId     String   @unique
  balance    Float    @default(0)
  heldAmount Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id])
}

model Product {
  id            String   @id @default(cuid())
  sellerId      String
  title         String
  description   String?
  images        String[]
  startingPrice Float
  category      String?
  condition     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  seller        User      @relation(fields: [sellerId], references: [id])
  auctions      Auction[]
}

model LiveStream {
  id          String    @id @default(cuid())
  sellerId    String
  title       String
  description String?
  streamKey   String    @unique @default(cuid())
  playbackUrl String?
  thumbnail   String?
  isActive    Boolean   @default(false)
  viewerCount Int       @default(0)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seller      User        @relation(fields: [sellerId], references: [id])
  auctions    Auction[]
  messages    ChatMessage[]
}

model Auction {
  id             String        @id @default(cuid())
  streamId       String
  productId      String
  sellerId       String
  title          String
  startingPrice  Float
  currentPrice   Float
  minBidStep     Float         @default(1)
  buyNowPrice    Float?
  status         AuctionStatus @default(UPCOMING)
  winnerId       String?
  duration       Int           @default(60)
  scheduledStart DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  stream         LiveStream    @relation(fields: [streamId], references: [id])
  product        Product       @relation(fields: [productId], references: [id])
  winner         User?         @relation("AuctionWinner", fields: [winnerId], references: [id])
  bids           Bid[]
}

model Bid {
  id        String    @id @default(cuid())
  auctionId String
  bidderId  String
  amount    Float
  status    BidStatus @default(ACTIVE)
  createdAt DateTime  @default(now())

  auction   Auction   @relation(fields: [auctionId], references: [id])
  bidder    User      @relation(fields: [bidderId], references: [id])
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Float
  status      TransactionStatus @default(PENDING)
  description String?
  reference   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        String     @id @default(cuid())
  streamId  String
  userId    String
  message   String
  isSystem  Boolean    @default(false)
  createdAt DateTime   @default(now())

  stream    LiveStream @relation(fields: [streamId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
}
